import {
  "moonrockz/okf",
  "moonrockz/okf/provider",
  "moonbitlang/async/fs",
}

import {
  "moonrockz/okf/fs",
  "moonrockz/okf",
  "moonrockz/okf/conformance",
  "moonrockz/okf/provider",
  "moonbitlang/async",
  "moonbitlang/async/fs" @afs,
} for "test"

// Native and wasm only: the store uses `moonbitlang/async/fs`, which has no js backend.

supported_targets = "native+wasm"
